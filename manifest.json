{
  "manifest_version": 3,
  "name": "Alacrity Guard",
  "version": "1.0",
  "description": "Enterprise AI surveillance and security compliance.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://copilot.microsoft.com/*",
        "*://gemini.google.com/*",
        "*://deepseek.com/*",
        "*://chat.deepseek.com/*",
        "*://openai.com/*",
        "*://claude.ai/*",
        "*://perplexity.ai/*",
        "*://mistral.ai/*",
        "*://grok.com/*",
        "*://x.ai/*"
      ],
      "js": ["scripts/extract.js", "scripts/content.js"],
      "css": ["style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "style.css"],
      "matches": ["<all_urls>"]
    }
  ]
}